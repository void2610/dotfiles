{
  "spinnerVerbs": {"mode":"replace","verbs":["Solo — a better place to run your agents"]},
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://d25nyrwm2wqzzf.cloudfront.net",
    "OTEL_RESOURCE_ATTRIBUTES": "user.email=shuya.izumi@akariinc.co.jp",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "claude-opus-4-7[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Opus 4.7",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Opus 4.7 (1M context)",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "mcp__ide__*",
      "Bash(~/.claude/skills/discord-image/send.sh:*)"
    ],
    "deny": [],
    "ask": [],
    "additionalDirectories": [
      "~/Documents/rclone"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/manual-mode-ask-all.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh Notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-unverified-redo.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bypass-allow-all.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {"type":"command","command":"node \"/Users/shuya.izumi/.kickbacks/vibe-ads-statusline.mjs\"","padding":0},
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "akaridou@akari-awesome-cc-plugins": true,
    "statusline@akari-awesome-cc-plugins": true,
    "warp@claude-code-warp": true,
    "swift-lsp@claude-plugins-official": true,
    "learning-output-style@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "akari-awesome-cc-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/AKARI-Inc/awesome-cc.git"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "language": "日本語",
  "effortLevel": "low",
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "model": "opus",
  "autoMode": {
    "allow": [
      "Notion の読み取り専用操作 (notion-fetch / notion-search / notion-query-data-sources の SELECT) は外部への書き込みではないので許可する",
      "ユーザー自身の Claude の auto memory ディレクトリ (~/.claude/projects/*/memory/) にある記憶ファイルの追加・編集・削除は許可する。ただし settings・hooks・skills は対象外",
      "自分で作った作業ブランチ (main / develop 以外) での git merge / rebase / switch / merge-tree と、force を伴わない push は許可する",
      "CLAUDE_GIT_SKILL=commit を前置した git add / git commit は、commit スキル経由の正規の操作なので許可する",
      "~/.claude/skills/ship/scripts/ship.sh のサブコマンド (status / report / skip 等) は、ユーザーが定義したワークフロー操作なので許可する",
      "gh pr comment による PR へのコメント投稿は許可する",
      "gh pr checkout と、作業ブランチ上での git reset --soft / --mixed (--hard は対象外) は許可する"
    ],
    "environment": [
      "$defaults",
      "**Organization**: ユーザーは AKARI Inc. (GitHub org `AKARI-Inc`) の開発者。主な作業はロボティクス (polaris / melchior 等) のソフトウェア開発",
      "**Source control**: GitHub org `AKARI-Inc` の全リポジトリと、ユーザー個人の GitHub リポジトリは信頼できる。~/Documents/GitHub/* 配下 (worktree の *-wt / *-wt2 を含む) と ~/dotfiles はユーザー自身の作業リポジトリ",
      "**Key internal services**: AKARI-Inc の GitHub (PR・Issue・Actions・self-hosted runner)、会社の Notion ワークスペース (タスク DB・ロードマップ)、会社の Slack。これらへの通常業務の読み書き (PR コメント・Notion タスク起票/更新・Slack の下書き) は社内の共有作業領域での業務であり、外部への流出ではない",
      "**Trusted cloud buckets**: ~/Documents/rclone 配下に rclone で同期する会社の Google Drive 共有フォルダ"
    ]
  }
}
